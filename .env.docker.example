# Copia este archivo a ".env" (en la raíz) antes de `docker compose up -d --build`.
# NUNCA subas el .env real: contiene secretos.

POSTGRES_PASSWORD=cambia-esto
# Mínimo 32 caracteres (por ejemplo: openssl rand -hex 32). El backend no arranca si es más corto.
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Puerto público del frontend y URL con la que los usuarios abren la tienda (CORS y enlaces de correo).
WEB_PORT=8080
FRONTEND_URL=http://localhost:8080

# Stripe (modo test mientras no se cobre dinero real)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Correo: console (imprime en logs) o smtp
EMAIL_DRIVER=console
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
