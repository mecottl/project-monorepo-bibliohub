{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": ["{workspaceRoot}/pnpm-lock.yaml", "{workspaceRoot}/.prettierrc.json"],
    "production": ["default", "!{projectRoot}/**/*.spec.ts", "!{projectRoot}/test/**/*", "!{projectRoot}/eslint.config.mjs"]
  },
  "targetDefaults": {
    "build": { "cache": true, "inputs": ["production", "^production"], "outputs": ["{projectRoot}/dist"] },
    "lint:check": { "cache": true, "inputs": ["default"] },
    "lint": { "cache": true, "inputs": ["default"] },
    "test": { "cache": true, "inputs": ["default"] }
  },
  "analytics": false
}
