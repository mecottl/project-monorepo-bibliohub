PORT=2077
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=bibliohubv1

JWT_SECRET=change-me
JWT_EXPIRES_IN=24h

STORAGE_DRIVER=local

# Modo test de Stripe (dashboard.stripe.com/test/apikeys) — el checkout online
# no funciona sin estas dos (STRIPE_WEBHOOK_SECRET sale de la config del
# webhook, dashboard.stripe.com/test/webhooks, o de `stripe listen` en local).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Recuperación de contraseña: EMAIL_DRIVER=console imprime el correo en el log
# (desarrollo); EMAIL_DRIVER=smtp envía de verdad con las variables de abajo.
EMAIL_DRIVER=console
EMAIL_FROM="BiblioHub <no-reply@ejemplo.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FRONTEND_URL=http://localhost:4200

# Seguridad. CORS_ORIGINS: orígenes del frontend separados por coma (por defecto
# http://localhost:4200). TRUST_PROXY=true si corre detrás de un proxy/balanceador.
# En producción JWT_SECRET debe tener >= 32 caracteres aleatorios
# (p. ej. `openssl rand -hex 32`) — el backend no arranca si es más corto.
CORS_ORIGINS=http://localhost:4200
TRUST_PROXY=false
